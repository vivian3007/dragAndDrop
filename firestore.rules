rules_version = '2';

// Beveiligingsregels voor Stitchify. De app zelf (React) is voor iedereen aan te passen;
// deze regels draaien op de server van Firebase en zijn dus de echte beveiliging.
//
// Gebruikers worden in de data aangeduid met hun Firebase-uid (user_id), daarom wordt hier
// steeds vergeleken met request.auth.uid. E-mailadressen staan bewust nergens in de database
// (alleen in Firebase Auth), zodat andere gebruikers ze niet kunnen uitlezen.
//
// Deployen: `npx firebase-tools deploy --only firestore:rules` (na `npx firebase-tools login`).
// Test wijzigingen eerst in de Rules Playground van de Firebase-console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function ownsAmigurumi(amigurumiId) {
      return get(/databases/$(database)/documents/amigurumi/$(amigurumiId)).data.user_id == myUid();
    }

    // Zelfde, maar met de toestand ná een batch: bij het kopiëren van een ontwerp worden het
    // ontwerp en z'n vormen in één batch aangemaakt.
    function ownsAmigurumiAfter(amigurumiId) {
      return getAfter(/databases/$(database)/documents/amigurumi/$(amigurumiId)).data.user_id == myUid();
    }

    // Een geldige gebruikersnaam: 3–20 tekens, kleine letters/cijfers/punt/underscore,
    // begint en eindigt met een letter of cijfer (zelfde regel als src/users/usernames.ts).
    function validUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 20
        && name.matches('^[a-z0-9]([a-z0-9._]*[a-z0-9])?$');
    }

    // Eigen gebruikersdocument (openbaar: alleen gebruikersnaam en aanmaakdatum). Alleen
    // jijzelf mag het aanmaken en wijzigen, en alleen met een gebruikersnaam die op jouw naam
    // gereserveerd is. Een e-mailadres is hier niet toegestaan.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && (!('username' in request.resource.data)
            || (validUsername(request.resource.data.username)
                && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid));
      allow delete: if false;
    }

    // Reserveringen van gebruikersnamen: het document-id ís de naam, dus elke naam kan maar
    // één keer bestaan. Alleen aanmaken (niet overschrijven) — daarmee is een naam uniek,
    // ook als twee mensen hem tegelijk proberen te nemen. Opvragen van één naam mag ook
    // zonder account (beschikbaarheid controleren bij registreren); de lijst opvragen niet.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update: if false;
      // Vrijgeven bij het kiezen van een nieuwe naam: alleen je eigen naam, en alleen als je
      // gebruikersdocument er (na deze batch) niet meer naar verwijst.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name;
    }

    // Persoonlijke favorieten: users/{uid}/favorites/{amigurumiId}. Alleen van jezelf, en
    // alleen lezen, aanmaken (met enkel een tijdstempel) en weer weghalen.
    match /users/{uid}/favorites/{amigurumiId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt']);
      allow update: if false;
    }

    // Ontwerpen: iedereen die is ingelogd mag ze bekijken (Home, profielen, kopiëren).
    // Alleen de eigenaar mag ze wijzigen of verwijderen. (Favorieten staan per gebruiker
    // hierboven; het oude gedeelde `favorite`-veld mag niemand anders meer omzetten.)
    match /amigurumi/{amigurumiId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == myUid();
      allow update: if signedIn()
        && resource.data.user_id == myUid() && request.resource.data.user_id == myUid();
      allow delete: if signedIn() && resource.data.user_id == myUid();
    }

    // Vormen horen bij een ontwerp; alleen de eigenaar van dat ontwerp mag ze aanpassen.
    match /shapes/{shapeId} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsAmigurumiAfter(request.resource.data.amigurumi_id);
      allow update: if signedIn() && ownsAmigurumi(resource.data.amigurumi_id)
        && request.resource.data.amigurumi_id == resource.data.amigurumi_id;
      allow delete: if signedIn() && ownsAmigurumi(resource.data.amigurumi_id);
    }

    // Garen: van wie het heeft opgeslagen. Oudere garendocumenten hebben nog geen eigenaar;
    // die mag een ingelogde gebruiker eenmalig "claimen" door er z'n eigen user_id in te zetten.
    match /yarn/{yarnId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == myUid();
      allow update: if signedIn() && request.resource.data.user_id == myUid()
        && (resource.data.get('user_id', null) == null || resource.data.user_id == myUid());
      allow delete: if false;
    }

    // Foto's van gemaakte amigurumi: iedereen mag kijken, alleen jijzelf mag jouw foto's
    // plaatsen of verwijderen. Achteraf wijzigen kan niet.
    match /makes/{makeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == myUid()
        && request.resource.data.keys().hasOnly(['amigurumi_id', 'amigurumi_name', 'user_id', 'imageUrl', 'note', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.user_id == myUid();
    }

    // Alles wat hierboven niet genoemd is: dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
